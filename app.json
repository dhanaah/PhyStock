{
  "expo": {
    "name": "AIS PhyStock",
    "slug": "dhanaah2",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aisstocktake",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1419",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0F1419",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aisglass.stocktake",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is used to scan QR codes on pallet labels for stock take."
      }
    },
    "android": {
      "package": "com.aisglass.stocktake",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F1419",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Camera access is used to scan QR codes on pallet labels for stock take.",
          "enableCodeScanner": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dc9eb903-5cb9-4c71-a7c6-80956dd2ee5f"
      }
    }
  }
}
